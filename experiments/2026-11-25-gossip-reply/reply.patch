diff --git a/wire/gossip_request_test.go b/wire/gossip_request_test.go
new file mode 100644
index 0000000..738cdbb
--- /dev/null
+++ b/wire/gossip_request_test.go
@@ -0,0 +1,39 @@
+package wire
+
+import (
+	"bytes"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestGossipRequestCanonicalCodec(t *testing.T) {
+	marker := Message{GossipRequest: &GossipRequest{}}
+	raw, err := body([]Message{marker})
+	if err != nil || !bytes.Equal(raw, []byte{9}) || MessageSize(marker) != 1 {
+		t.Fatal(raw, err)
+	}
+	messages, err := DecodeBody(raw)
+	if err != nil || len(messages) != 1 || !reflect.DeepEqual(messages[0], marker.Clone()) {
+		t.Fatal(messages, err)
+	}
+	if (Message{GossipRequest: &GossipRequest{}, Ack: &Ack{}}).Validate() == nil {
+		t.Fatal("accepted two variants")
+	}
+	for _, options := range []Options{{}, {Label: strings.Repeat("l", MaxLabel)}, {Label: "protected", Keys: []Key{mustKey(t, 7)}}} {
+		member := Member{Identity: identity("n", "192.0.2.1:7946", 8), Incarnation: 1}
+		want := []Message{marker, {Alive: &member}}
+		frame, err := Encode(want, options)
+		if err != nil {
+			t.Fatal(err)
+		}
+		size, err := Size(want, options.Label, len(options.Keys) > 0)
+		if err != nil || len(frame) != size {
+			t.Fatal("marker size", size, len(frame), err)
+		}
+		got, err := Decode(frame, options)
+		if err != nil || !reflect.DeepEqual(got, want) {
+			t.Fatal("marker round trip", got, err)
+		}
+	}
+}
