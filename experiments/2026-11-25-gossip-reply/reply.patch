diff --git a/core/gossip_reply_test.go b/core/gossip_reply_test.go
new file mode 100644
index 0000000..cde552b
--- /dev/null
+++ b/core/gossip_reply_test.go
@@ -0,0 +1,234 @@
+package core
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/modulecollective/lightpool/wire"
+)
+
+func gossipSends(es []Effect) []SendDatagram {
+	var out []SendDatagram
+	for _, e := range es {
+		if s, ok := e.(SendDatagram); ok {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+func gossipQueue(t *testing.T) *Core {
+	t.Helper()
+	c := testCore(t)
+	c.broadcasts = nil
+	c.broadcastKeys = make(map[string]*broadcast)
+	c.queue(wire.Message{Alive: ptrMember(wire.Member{Identity: identity("queued", 3), Incarnation: 1})}, "queued", 0)
+	return c
+}
+
+func gossipPacket() []wire.Message {
+	return []wire.Message{{GossipRequest: &wire.GossipRequest{}}, {Alive: ptrMember(wire.Member{Identity: identity("new", 4), Incarnation: 1})}}
+}
+
+func TestGossipReplyBeforeAdmissionAndAccounting(t *testing.T) {
+	c := gossipQueue(t)
+	from := identity("sender", 9).Address
+	request := Datagram{From: from, Messages: gossipPacket()}
+	limit := retransmitLimit(c.config.RetransmitMult, len(c.nodes))
+	for i := range limit {
+		es := step(t, c, 0, request)
+		sends := gossipSends(es)
+		if len(sends) != 1 || sends[0].To != from || len(sends[0].Messages) != 1 || sends[0].Messages[0].Alive == nil || sends[0].Messages[0].Alive.Name != "queued" {
+			t.Fatal("reply must use pre-admission queue exactly once", sends)
+		}
+		if c.nodes["new"] != nil {
+			t.Fatal("membership skipped deferred path")
+		}
+		if i < limit-1 && (len(c.broadcasts) != 1 || c.broadcasts[0].transmits != i+1) {
+			t.Fatal("reply counters", c.broadcasts)
+		}
+	}
+	if len(c.broadcasts) != 0 {
+		t.Fatal("reply did not exhaust budget")
+	}
+	if sends := gossipSends(step(t, c, 0, request)); len(sends) != 0 {
+		t.Fatal("exhausted queue replied", sends)
+	}
+	// Existing deferred work must still make the incoming record reachable.
+	step(t, c, 0, Work{ID: c.work})
+	if c.nodes["new"] == nil {
+		t.Fatal("request record never admitted")
+	}
+}
+
+func TestGossipRepliesDoNotLoop(t *testing.T) {
+	for _, messages := range [][]wire.Message{
+		{{Alive: ptrMember(wire.Member{Identity: identity("b", 2), Incarnation: 1})}},
+		{{Ack: &wire.Ack{Sequence: 123}}},
+		{{Nack: &wire.Ack{Sequence: 123}}},
+	} {
+		c := gossipQueue(t)
+		es := step(t, c, 0, Datagram{From: identity("b", 2).Address, Messages: messages})
+		if sends := gossipSends(es); len(sends) != 0 {
+			t.Fatal("unmarked packet elicited a reply", sends)
+		}
+		if c.broadcasts[0].transmits != 0 {
+			t.Fatal("unmarked packet spent reply budget")
+		}
+	}
+	c := gossipQueue(t)
+	p := wire.Ping{Sequence: 7, Target: "a", Source: identity("b", 2)}
+	sends := gossipSends(step(t, c, 0, Datagram{From: p.Source.Address, Messages: []wire.Message{{Ping: &p}}}))
+	if len(sends) != 1 || sends[0].Messages[0].Ack == nil || sends[0].Messages[0].Ack.Sequence != 7 {
+		t.Fatal("ping behavior changed", sends)
+	}
+}
+
+func TestGossipRejectWholeMalformedRequest(t *testing.T) {
+	marker, record := gossipPacket()[0], gossipPacket()[1]
+	for _, messages := range [][]wire.Message{
+		{marker}, {record, marker}, {marker, marker, record},
+		{marker, record, {Ack: &wire.Ack{}}},
+		{marker, record, {Ping: &wire.Ping{Sequence: 1, Target: "a", Source: identity("b", 2)}}},
+		{marker, {Exchange: &wire.Exchange{}}},
+		{marker, record, {}},
+	} {
+		c := gossipQueue(t)
+		before := c.stats.Datagrams
+		_, err := c.Step(0, Datagram{From: identity("b", 2).Address, Messages: messages})
+		if err == nil {
+			t.Fatal("accepted malformed request", messages)
+		}
+		if len(c.effects) != 0 || len(c.high) != 0 || len(c.low) != 0 || c.broadcasts[0].transmits != 0 || c.stats.Datagrams != before {
+			t.Fatal("partial request admitted", c.effects)
+		}
+	}
+	c := gossipQueue(t)
+	if _, err := c.Step(0, StreamMessage{ID: c.token(), Messages: []wire.Message{record, marker}}); err == nil {
+		t.Fatal("stream marker accepted")
+	}
+	if len(c.effects) != 0 || c.broadcasts[0].transmits != 0 {
+		t.Fatal("stream caused reply")
+	}
+}
+
+func TestGossipMarkerBudgetAndBatch(t *testing.T) {
+	for _, protected := range []bool{false, true} {
+		c := gossipQueue(t)
+		c.config.Label = strings.Repeat("l", wire.MaxLabel)
+		c.config.Protected = protected
+		c.config.PacketBudget = 256
+		// This record exactly fits an unmarked packet, but not a request.
+		member := wire.Member{Identity: identity("queued", 3), Incarnation: 1}
+		for {
+			n, err := wire.Size([]wire.Message{{Alive: &member}}, c.config.Label, protected)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if n == c.config.PacketBudget {
+				break
+			}
+			member.Meta = append(member.Meta, 0)
+		}
+		c.queue(wire.Message{Alive: &member}, "queued", 0)
+		c.effects = nil
+		c.gossip()
+		if len(gossipSends(c.effects)) != 0 || c.broadcasts[0].transmits != 0 {
+			t.Fatal("marker-only poll or budget spent")
+		}
+		c.datagram(identity("b", 2).Address, nil, 0)
+		sends := gossipSends(c.effects)
+		if len(sends) != 1 || sends[0].Messages[0].GossipRequest != nil {
+			t.Fatal("ordinary path lost fitting record")
+		}
+		n, err := wire.Size(sends[0].Messages, c.config.Label, protected)
+		if err != nil || n != c.config.PacketBudget {
+			t.Fatal(n, err)
+		}
+		c.effects = nil
+		member.Meta = member.Meta[:len(member.Meta)-1]
+		c.queue(wire.Message{Alive: &member}, "queued", 0)
+		c.gossip()
+		sends = gossipSends(c.effects)
+		if len(sends) != 1 || len(sends[0].Messages) != 2 || sends[0].Messages[0].GossipRequest == nil {
+			t.Fatal("request marker missing")
+		}
+		n, err = wire.Size(sends[0].Messages, c.config.Label, protected)
+		if err != nil || n != c.config.PacketBudget {
+			t.Fatal("marked packet boundary", n, err)
+		}
+	}
+	c := gossipQueue(t)
+	c.config.PacketBudget = 65507
+	for i := range wire.MaxBatch {
+		name := fmt.Sprintf("record-%03d", i)
+		c.queue(wire.Message{Alive: ptrMember(wire.Member{Identity: identity(name, uint16(i+10)), Incarnation: 1})}, name, 0)
+	}
+	c.effects = nil
+	c.gossip()
+	sends := gossipSends(c.effects)
+	if len(sends) != 1 || len(sends[0].Messages) != wire.MaxBatch || sends[0].Messages[0].GossipRequest == nil {
+		t.Fatal("batch slot not reserved")
+	}
+	total := 0
+	for _, b := range c.broadcasts {
+		total += b.transmits
+	}
+	if total != wire.MaxBatch-1 {
+		t.Fatal("pack spent counters twice", total)
+	}
+}
+
+func TestGossipDuplicateLossTermination(t *testing.T) {
+	a, b := gossipQueue(t), gossipQueue(t)
+	// Leave membership work deferred to isolate send-budget termination.
+	// Admission and replenishment by a new record are exercised separately.
+	requests, replies := 0, 0
+	for range 20 {
+		a.effects = nil
+		a.gossip()
+		for _, request := range gossipSends(a.effects) {
+			requests++
+			for duplicate := range 2 {
+				es := step(t, b, 0, Datagram{From: a.nodes[a.self].Address, Messages: request.Messages})
+				for _, reply := range gossipSends(es) {
+					replies++
+					if duplicate == 0 {
+						continue
+					} // lose one of the replies
+					if sends := gossipSends(step(t, a, 0, Datagram{From: b.nodes[b.self].Address, Messages: reply.Messages})); len(sends) != 0 {
+						t.Fatal("reply loop")
+					}
+				}
+			}
+		}
+	}
+	if requests != retransmitLimit(a.config.RetransmitMult, len(a.nodes)) || replies != retransmitLimit(b.config.RetransmitMult, len(b.nodes)) || len(a.broadcasts) != 0 || len(b.broadcasts) != 0 {
+		t.Fatal("finite-budget termination", requests, replies)
+	}
+	a.effects = nil
+	a.gossip()
+	if len(gossipSends(a.effects)) != 0 {
+		t.Fatal("empty queue solicited a reply")
+	}
+}
+
+func TestGossipRequestMembershipKindsAndNonfittingQueue(t *testing.T) {
+	c := gossipQueue(t)
+	record := gossipPacket()[1]
+	accusation := wire.Accusation{Node: "b", Incarnation: 1, From: "sender"}
+	messages := []wire.Message{gossipPacket()[0], record, {Suspect: &accusation}, {Dead: &accusation}}
+	sends := gossipSends(step(t, c, 0, Datagram{From: identity("sender", 9).Address, Messages: messages}))
+	if len(sends) != 1 || len(c.high) != 1 || len(c.low) != 2 {
+		t.Fatal("request membership dispatch", sends, len(c.high), len(c.low))
+	}
+	c = gossipQueue(t)
+	c.config.PacketBudget = 256
+	member := c.broadcasts[0].message.Alive.Clone()
+	member.Meta = make([]byte, wire.MaxMeta)
+	c.queue(wire.Message{Alive: &member}, member.Name, 0)
+	if sends := gossipSends(step(t, c, 0, Datagram{From: identity("sender", 9).Address, Messages: gossipPacket()})); len(sends) != 0 || c.broadcasts[0].transmits != 0 {
+		t.Fatal("nonfitting queue replied or spent budget", sends)
+	}
+}
