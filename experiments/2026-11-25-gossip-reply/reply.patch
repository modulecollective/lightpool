diff --git a/sim/gossip_reply_test.go b/sim/gossip_reply_test.go
new file mode 100644
index 0000000..7497281
--- /dev/null
+++ b/sim/gossip_reply_test.go
@@ -0,0 +1,42 @@
+package sim
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/modulecollective/lightpool/sim/trace"
+)
+
+func TestGossipRequestExport(t *testing.T) {
+	var output bytes.Buffer
+	result, err := Export(fixture(), &output, ExportOptions{})
+	if err != nil || !result.Complete {
+		t.Fatal(result.Reason, err)
+	}
+	requests := 0
+	complete, err := trace.Read(bytes.NewReader(output.Bytes()), func(raw json.RawMessage) error {
+		var event trace.Event
+		if err := json.Unmarshal(raw, &event); err != nil {
+			return err
+		}
+		for _, traffic := range event.Traffic {
+			if traffic.Stage != "attempt" || len(traffic.Messages) == 0 || traffic.Messages[0] != "gossip-request" {
+				continue
+			}
+			requests++
+			if len(traffic.Messages) < 2 {
+				t.Fatal("marker-only attempt")
+			}
+			for _, kind := range traffic.Messages[1:] {
+				if kind != "alive" && kind != "suspect" && kind != "dead" {
+					t.Fatal("invalid request", traffic.Messages)
+				}
+			}
+		}
+		return nil
+	})
+	if err != nil || !complete || requests == 0 {
+		t.Fatal("request labels lost from validated trace", requests, err)
+	}
+}
