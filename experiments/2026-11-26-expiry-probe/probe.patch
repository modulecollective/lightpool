+// armSuspicion keeps the deadline where it was and asks the suspect directly
+// once, one ProbeTimeout before it: an observer that missed a refutation holds
+// a stale incarnation, and nothing else repairs it before the next exchange.
+func (c *Core) armSuspicion(name string, s *suspicion) {
+	at := s.start.Add(s.duration())
+	c.arm("suspect:"+name, "suspicion", at, 0, name)
+	if s.probing == 0 && at > c.now {
+		// A separate key: arm replaces by key, and the deadline must stay armed.
+		c.arm("expiry-probe:"+name, "expiry-probe", at.Add(-c.config.ProbeTimeout), 0, name)
+	} else {
+		c.cancel("expiry-probe:" + name)
+	}
 }
 
