{
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "prettier": "3.8.3",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "name": "lightpool-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "smoke": "playwright test",
    "format:check": "prettier --check src tests index.html playwright.config.ts tsconfig.json package.json README.md"
  },
  "dependencies": {
    "pixi.js": "8.23.0"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
